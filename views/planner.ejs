<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 2rem;
    }
    h1 {
      margin-bottom: 1rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 8px 12px;
      border: 1px solid #ccc;
      text-align: left;
    }
    th {
      background-color: #f4f4f4;
    }
    .status {
      font-weight: bold;
    }
    .green { color: green; }
    .blue { color: blue; }
    .yellow { color: goldenrod; }
  </style>
</head>
<body>
  <h1><%= title %></h1>

  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Day</th>
        <th>Task</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% tasks.forEach(task => { %>
        <tr>
          <td><%= task.date %></td>
          <td><%= task.day %></td>
          <td><%= task.task %></td>
          <td class="status <%= task.color %>"><%= task.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
